{
  "manifest_version": 3,
  "name": "图提取 ImageGrab",
  "version": "1.0.0",
  "description": "一键提取淘宝、京东、拼多多商家版商品详情页的所有图片，集中预览并批量下载为 PNG 格式。",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "*://*.taobao.com/*",
    "*://*.tmall.com/*",
    "*://*.jd.com/*",
    "*://*.pinduoduo.com/*",
    "*://*.yangkeduo.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.taobao.com/*",
        "*://*.tmall.com/*",
        "*://*.jd.com/*",
        "*://*.pinduoduo.com/*",
        "*://*.yangkeduo.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "gallery.html",
        "gallery.js",
        "gallery.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
